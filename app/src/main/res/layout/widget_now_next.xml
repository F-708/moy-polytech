<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Сейчас и дальше».
     Два блока делят высоту поровну (0dp + weight), поэтому пустого места
     внизу не остаётся — при любом размере виджета он заполнен целиком.
     DD: idle-блок (колокольчик + надпись) — вертикальный LinearLayout,
     центрируется gravity="center" корня; в обычном состоянии его дети
     GONE и блок схлопывается в ноль, не влияя на раскладку. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- v2.0: фон со скруглением (shape + setColorFilter в провайдере) -->
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_r0" />

<LinearLayout
    android:id="@+id/now_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Блок «сейчас» -->
    <LinearLayout
        android:id="@+id/ll_now_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_now_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="СЕЙЧАС"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#6B7280"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_now_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="14sp"
            android:textColor="#111827"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- N7: строка «время + кабинет». Время занимает всю ширину (weight=1),
             чип кабинета вытесняется в правый конец строки — не поверх текста
             «СЕЙЧАС/ДАЛЬШЕ» и не заезжает на разделитель. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_now_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#0B3564"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Б7/N7: кабинет — отдельная кнопка-чип, на неё вешается свой
                 PendingIntent (карта с этим кабинетом). Цвет фона и текста ставится
                 из кода по стилю виджета (highlightColor/mainColor) — контраст во
                 всех 4 темах. При showRoom=false или пустом кабинете прячется (gone). -->
            <TextView
                android:id="@+id/tv_now_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_widget_room_chip"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text=""
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0B3564"
                android:maxLines="1"
                android:visibility="gone" />

            <!-- GG8в: вторая комната split-урока (цифра без «каб.»), видна только
                 при isSplit && SubgroupPref==NEUTRAL. -->
            <TextView
                android:id="@+id/tv_now_room2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_widget_room_chip"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text=""
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0B3564"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/v_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Блок «дальше» -->
    <LinearLayout
        android:id="@+id/ll_next_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ДАЛЬШЕ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#6B7280"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_next_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="14sp"
            android:textColor="#111827"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- N7: строка «время + кабинет» — чип справа, как в блоке «сейчас» -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_next_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#0B3564"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_next_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_widget_room_chip"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text=""
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0B3564"
                android:maxLines="1"
                android:visibility="gone" />

            <!-- GG8в: вторая комната split-урока, как tv_now_room2 -->
            <TextView
                android:id="@+id/tv_next_room2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_widget_room_chip"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text=""
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0B3564"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- DD: idle-блок на всё пустое состояние (группа не выбрана / уроков нет /
         уроки закончились). Колокольчик строго по центру виджета, надпись ниже.
         Текст и цвет tv_empty ставятся из кода; блоки и разделитель провайдер
         прячет (gone), а gravity="center" корня центрирует этот блок. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/iv_idle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text=""
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
