<?xml version="1.0" encoding="utf-8"?>
<!-- Общая строка списка для виджетов «Расписание» и «Звонки» -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/row_number"
        android:layout_width="wrap_content"
        android:minWidth="18dp"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/row_time"
        android:layout_width="wrap_content"
        android:minWidth="82dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/row_subject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/row_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:maxLines="1" />

    <!-- GG9: вторая комната split-урока (цифра без «каб.»); видна только при
         isSplit && SubgroupPref==NEUTRAL, стиль/фон ставит провайдер. -->
    <TextView
        android:id="@+id/row_room2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textSize="11sp"
        android:maxLines="1"
        android:visibility="gone" />

</LinearLayout>
