<?xml version="1.0" encoding="utf-8"?>
<!-- N5: кастомная строка «до звонка» — крупные цифры (как в Яндекс.Погоде), а не просто
     название+подпись. Цвета текста НЕ задаём: наследуются от системного оформления
     уведомлений (адаптив тёмная/светлая тема), иначе белые цифры на белом фоне нечитаемы. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nbell_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nbell_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/nbell_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/nbell_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textSize="10sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/nbell_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:visibility="gone" />
</LinearLayout>
