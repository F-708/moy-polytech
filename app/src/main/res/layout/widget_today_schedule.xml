<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- v2.0: фон со скруглением (shape + setColorFilter в провайдере) -->
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_r0" />

    <LinearLayout
        android:id="@+id/today_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_today_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="РАСПИСАНИЕ"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#0B3564"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:background="#E2E8F0" />

        <LinearLayout
            android:id="@+id/today_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- DD: idle-блок — колокольчик строго по центру виджета, надпись ниже.
         today_rows в пустом состоянии остаётся видимым (weight=1), поэтому
         блок центрируется поверх свободного места; он не clickable — клики
         по виджету (PendingIntent на today_root) проходят насквозь.
         Оба ребёнка по умолчанию GONE → в обычном состоянии блок нулевой. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <ImageView
            android:id="@+id/iv_idle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_today_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="На сегодня уроков нет"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
