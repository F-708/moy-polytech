<?xml version="1.0" encoding="utf-8"?>
<!-- CC9: idle-анимация виджетов «нет уроков/нет таймера» — колокольчик покачивается
     несколько раз и замирает (repeatCount=3, цикл 1200мс туда + reverse). Конечный
     repeat вместо infinite — иначе AVD крутился бы вечно и жрал батарею (МЕЛОЧ20);
     после проигрывания остаётся статичный кадр, idle-визуал сохранён.
     AnimatedVectorDrawable автостартует в ImageView виджета на API 24+ (minSdk 24).
     Цвет нейтральный серо-голубой — читается на всех 4 темах виджетов. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="40dp"
            android:height="40dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="bell_swing"
                android:pivotX="12"
                android:pivotY="3">
                <path
                    android:fillColor="#9AA7BC"
                    android:pathData="M12,22c1.1,0 2,-0.9 2,-2h-4c0,1.1 0.9,2 2,2zM18,16v-5c0,-3.07 -1.63,-5.64 -4.5,-6.32L13.5,4c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v0.68C7.64,5.36 6,7.92 6,11v5l-2,2v1h16v-1l-2,-2z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="bell_swing">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="-12"
                android:valueTo="12"
                android:duration="1200"
                android:valueType="floatType"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                android:repeatCount="3"
                android:repeatMode="reverse" />
        </aapt:attr>
    </target>
</animated-vector>
