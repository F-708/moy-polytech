<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Служба минутного отсчёта «До звонка» (работает только при включённой строке) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MpkApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!-- singleTop: тап по виджету/уведомлению в тёплом приложении доставляет
             onNewIntent (переключение вкладки) вместо создания копии активити -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- «Поделиться» одним файлом. Только форматы, которые реально открываются
                 встроенными вьюерами: PDF, DOCX, текстовые, изображения.
                 octet-stream остаётся, иначе из файловых менеджеров вообще ничего не
                 пошлёшь; мусор из него отсекает runtime-гейт MaterialFormats. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- «Поделиться» набором изображений -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- «Открыть с помощью» — только форматы, которые умеет отрисовать встроенный
             вьюер: PDF, DOCX, текстовые, изображения. Чтение content:// даётся временным
             grant'ом отправителя (FLAG_GRANT_READ_URI_PERMISSION), файлы сразу копируются
             во внутреннее хранилище, а формат дополнительно проверяется в runtime
             (MaterialFormats): провайдеры часто врут про тип файла.

             ВАЖНО: scheme и mimeType (или pathPattern) обязаны стоять в ОДНОМ <data>.
             Отдельный <data android:scheme="content"/> сам по себе матчит любой content-Uri
             и снова открывает приём всего подряд — именно так приложение и принимало APK. -->
        <activity-alias
            android:name=".FileViewAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="Просмотреть файл">
            <!-- Документы, которые открываются встроенными вьюерами -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="content" android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="text/csv" />
                <data android:scheme="content" android:mimeType="application/json" />
                <data android:scheme="content" android:mimeType="application/xml" />
                <data android:scheme="content" android:mimeType="text/xml" />
            </intent-filter>

            <!-- Изображения, которые отрисовывает Coil -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="image/jpeg" />
                <data android:scheme="content" android:mimeType="image/png" />
                <data android:scheme="content" android:mimeType="image/webp" />
                <data android:scheme="content" android:mimeType="image/bmp" />
                <data android:scheme="content" android:mimeType="image/gif" />
                <data android:scheme="content" android:mimeType="image/heic" />
                <data android:scheme="content" android:mimeType="image/heif" />
            </intent-filter>

            <!-- octet-stream (так шлют файловые менеджеры) — только с известным расширением.
                 Ни архивов, ни таблиц, ни .doc, ни аудио/видео здесь нет: приложение не
                 должно появляться в «Открыть с помощью» для того, что не откроет. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.pdf" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.PDF" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.docx" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.DOCX" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.txt" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.TXT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.md" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.MD" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.csv" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.CSV" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.log" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.LOG" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.json" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.JSON" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.xml" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.XML" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.png" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.PNG" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.jpg" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.JPG" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.jpeg" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.JPEG" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.webp" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.WEBP" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.bmp" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.BMP" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.gif" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.GIF" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.heic" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.HEIC" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.heif" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.HEIF" />
            </intent-filter>
        </activity-alias>

        <!-- Виджет «До звонка» (2x1, настраиваемый цвет фона) -->
        <receiver
            android:name=".widget.BellCountdownWidgetProvider"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:label="До звонка">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bell_countdown_widget_info" />
        </receiver>

        <!-- Виджет «Сейчас / дальше» (3x2): что идёт сейчас и что будет следующим -->
        <receiver
            android:name=".widget.NowNextWidgetProvider"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:label="Сейчас и дальше">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_next_widget_info" />
        </receiver>

        <!-- Виджет «Расписание на сегодня» (4x4): весь день списком -->
        <receiver
            android:name=".widget.TodayScheduleWidgetProvider"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:label="Расписание на сегодня">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_schedule_widget_info" />
        </receiver>

        <!-- Виджет «Звонки» (2x4): расписание звонков с подсветкой текущего -->
        <receiver
            android:name=".widget.BellsWidgetProvider"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:label="Звонки">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bells_widget_info" />
        </receiver>

        <!-- Настройка виджета при добавлении -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Служба минутного отсчёта «До звонка» и обновления виджета -->
        <service
            android:name=".util.BellTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Постоянный обратный отсчёт до звонка в строке уведомлений и посекундное обновление виджетов" />
        </service>

        <!-- Минутный тик виджета + перезапуск будильника после перезагрузки/обновения -->
        <receiver
            android:name=".widget.WidgetAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.politex.widget.ACTION_BELL_COUNTDOWN_TICK" />
                <action android:name="com.politex.widget.ACTION_BELL_COUNTDOWN_SECOND_TICK" />
                <action android:name="com.politex.widget.ACTION_WINDOW_WAKE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- SRED4: после обновления приложения системные будильники сброшены —
                     перепланировать тик и обновить виджеты, как после загрузки -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- QA#1: fallback-будильник watchdog'а — старт BellTimerService из exempt-контекста
             (точный будильник), когда прямой startForegroundService из воркера запрещён (12+) -->
        <receiver
            android:name=".worker.BellServiceAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.politex.worker.ACTION_START_BELL_SERVICE" />
            </intent-filter>
        </receiver>

        <!-- X43: смена даты/времени/часового пояса системы — перепланировать виджеты,
             будильник и воркеры (иначе они залипают в старом состоянии). Эти системные
             broadcasts в списке исключений фонового ограничения, манифест-ресивер их
             получает даже на API 26+. exported=false: их шлёт только система. -->
        <receiver
            android:name=".widget.TimeChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".update.UpdateInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>
